# ==============================================================================
# JARVIS — Variables d'Environnement pour Déploiement Vercel
# Renseignez ces variables dans : Vercel Dashboard > Project > Settings > Environment Variables
# ==============================================================================

# 1. INTELLIGENCE ARTIFICIELLE (NVIDIA NIM)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_FAST=meta/llama-3.2-11b-vision-instruct

# 2. BASE DE DONNÉES & AUTHENTIFICATION (SUPABASE)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. SÉCURITÉ & PROFIL UTILISATEUR
ALLOWED_USER_EMAIL=kossoumichelroystenseweto@gmail.com
APP_SECRET_KEY=your_app_secret_key_here

# 4. RECHERCHE WEB (TAVILY)
TAVILY_API_KEY=your_tavily_api_key_here
